{
  "name": "tendermind",
  "version": "1.0.0",
  "description": "AI-powered government tender discovery using Webcmd browser automation",
  "main": "backend/server.js",
  "scripts": {
    "dev": "vite",
    "server":"node backend/server.js",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node backend/server.js",
    "webcmd:search": "webcmd wbtenders search",
    "webcmd:detail": "webcmd wbtenders detail",
    "webcmd:init": "node webcmd-setup/init-adapter.js",
    "agent:demo": "node demo/agent-demo.js",
    "simple-demo": "node demo/simple-demo.js",
    "demo": "node demo/complete-demo.js",
    "test": "node tests/eligibility-analyzer.test.js",
    "test:eligibility": "node tests/eligibility-analyzer.test.js",
    "verify:gemini": "node tests/verify-gemini.js",
    "test:integration": "node tests/integration-test.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.3.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "nodemon": "^3.0.1",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
